# =====================================================================
# Somali Cardiac Society (SCS) — Apache .htaccess
# Works on both local XAMPP (/ssc/) and production root domain (/)
# =====================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Set Default Charset
AddDefaultCharset UTF-8

# 3. Security Headers
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Block Access to Sensitive Files & Folders
<FilesMatch "^(\.env|\.gitignore|\.git|.*\.sql|.*\.bak|.*\.log|.*\.sh|.*\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to internal folders
<IfModule mod_rewrite.c>
    RewriteEngine On

    # ── Auto-detect base path (local /ssc/ vs production /) ──────────────
    # Strip /ssc prefix if running locally under XAMPP
    RewriteCond %{REQUEST_URI} ^/ssc/(.*)$
    RewriteRule ^ - [E=BASE_PATH:/ssc]

    RewriteCond %{REQUEST_URI} !^/ssc/
    RewriteRule ^ - [E=BASE_PATH:]

    # ── Force HTTPS on production ─────────────────────────────────────────
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\. [NC]
    RewriteCond %{HTTP_HOST} !^::1 [NC]
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # ── Block direct access to config/includes/database folders ───────────
    RewriteRule ^(config|includes|database)(/|$) - [F,L]

    # ── Remove .php extension: redirect /page.php → /page ─────────────────
    # For local XAMPP (running under /ssc/)
    RewriteCond %{THE_REQUEST} \s/ssc/([^/?\ ]+)\.php[\s?] [NC]
    RewriteRule ^ /ssc/%1 [R=301,L]

    # For production (running at root /)
    RewriteCond %{THE_REQUEST} \s/([^/?\ ]+)\.php[\s?] [NC]
    RewriteCond %{THE_REQUEST} !\s/ssc/ [NC]
    RewriteRule ^ /%1 [R=301,L]

    # ── Internally map extensionless URLs to .php files ───────────────────
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([^.]+)$ $1.php [NC,L]
</IfModule>

# 5. Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# 6. Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
