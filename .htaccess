# =====================================================================
# Somali Cardiac Society (SCS) — Apache .htaccess Configuration
# Security, Clean URLs (.php removal), Caching & Hardening
# =====================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Set Default Charset & Timezone
AddDefaultCharset UTF-8

# 3. Security Headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Block Access to Sensitive Files & Folders
<FilesMatch "^\.(env|gitignore|git|ht.*)|.*\.(sql|bak|log|md|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# 5. URL Rewriting (Clean URLs & Hiding .php Extensions)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /ssc/

    # Block direct access to internal include/config/database folders
    RewriteRule ^(config|includes|database)/ - [F,L]

    # Force HTTPS (Uncomment line below in production server with SSL)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect external .php requests to extensionless URLs (e.g. /about.php -> /about)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /ssc/([^/]+)\.php\ HTTP/
    RewriteRule ^([^/]+)\.php$ /ssc/$1 [R=301,L]

    # Map extensionless URLs internally to .php files (e.g. /about -> about.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^\.]+)$ $1.php [NC,L]
</IfModule>

# 6. Browser Caching for Performance
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>
