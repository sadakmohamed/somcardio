# =====================================================================
# Somali Cardiac Society (SCS) — Environment Template Example
# Copy this file to .env and fill in your actual server configuration
# =====================================================================

# Environment Mode: 'development' or 'production'
APP_ENV=production
APP_NAME="Somali Cardiac Society"
APP_URL=https://somalicardiac.org

# Database Credentials
DB_HOST=localhost
DB_PORT=3306
DB_NAME=scs_db
DB_USER=your_db_user
DB_PASS=your_db_password
DB_CHARSET=utf8mb4

# Contact Form Email Receiver
CONTACT_EMAIL=sadikothm@gmail.com

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_ENCRYPTION=tls
